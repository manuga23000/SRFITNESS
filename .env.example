# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > App web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: usar los emulators locales de Firebase en `npm run dev` (ver README)
# VITE_USE_EMULATORS=true
